% ---------------------------------------------------------------------------
% EXEMPLOS DE ENTRADAS conforme o Manual de Normalização da UFV (2025)
% Copie e adapte. Convenções para o biblatex-abnt:
%  - TCC/dissertação/tese: use @thesis e informe a data da defesa em eventdate
%    (ela é impressa ao final: "... Universidade X, Cidade, UF, ano.");
%  - documento online (livro, relatório, site): use @book (ou @report) com url
%    e urldate; @online não imprime local e editora;
%  - intervalo de meses: date = {2003-11/2003-12} gera "nov./dez. 2003";
%  - obra sem autoria: omita author; se o título começar por artigo ou
%    monossílabo, preencha shorttitle (ex.: shorttitle = {A flor}) para que a
%    citação saia "(A flor [...], 1995)"; na lista, escreva em maiúsculas o
%    artigo e a palavra seguinte no próprio title ({A FLOR prometida}).
% ---------------------------------------------------------------------------

@thesis{exemplo-tcc,
  author      = {Alves, D. P.},
  title       = {Implementação de conceitos de manufatura colaborativa},
  subtitle    = {um projeto virtual},
  type        = {Trabalho de Conclusão de Curso (Bacharelado em Sistemas de Informação)},
  institution = {Universidade Federal de Viçosa},
  location    = {Rio Paranaíba, MG},
  year        = {2008},
  eventdate   = {2008},
}

