# Configuração do latexmk para o modelo (pasta modelo-tcc/)
#
# Uso (nesta pasta):   latexmk        compila modelo-tcc.pdf
#                      latexmk -c     apaga os auxiliares (mantém o PDF)
#                      latexmk -C     apaga auxiliares e PDF
#
# O PDF fica nesta pasta; os arquivos auxiliares (.aux, .bbl, .toc etc.) ficam em build/.
# O abntex2-ufv.cls (e o .sty) são procurados na pasta pai (..). Se você copiar este modelo para outro
# lugar, copie também o .sty para a mesma pasta e apague a linha ensure_path abaixo.

$pdf_mode   = 1;            # gera PDF com pdflatex
$aux_dir    = 'build';      # arquivos auxiliares
$out_dir    = '.';          # PDF final
$bibtex_use = 2;            # executa o biber quando necessário
$pdflatex   = 'pdflatex -synctex=1 -interaction=nonstopmode %O %S';
$max_repeat = 6;            # número máximo de passagens do pdflatex
ensure_path('TEXINPUTS', '..');
